# Foundry RPC endpoints
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployment signer
# Prefer Foundry keystore/account flags for production:
# forge script script/DeployStrategyVault.s.sol:DeployStrategyVault --rpc-url arbitrum --account YOUR_KEYSTORE --sender 0xYOUR_DEPLOYER_ADDRESS --broadcast

# StrategyVault deployment inputs
# Arbitrum USDC. Replace only if deploying a vault for a different collateral asset.
STRATEGY_VAULT_ASSET=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# End-user vault owner. Required explicitly on Arbitrum mainnet.
STRATEGY_VAULT_OWNER=0xYOUR_VAULT_OWNER

# Upgrade authority for the shared beacon. Use a multisig/timelock in production.
# On Arbitrum mainnet this must be explicit.
BEACON_OWNER=0xYOUR_MULTISIG_OR_TIMELOCK

# GMX v2 Arbitrum mainnet routing. The deploy script enforces these exact values on chain 42161.
GMX_EXCHANGE_ROUTER=0x1C3fa76e6E1088bCE750f23a5BFcffa1efEF6A41
GMX_ROUTER=0x7452c558d45f8afC8c83dAe62C3f8A5BE19c71f6
GMX_ORDER_VAULT=0x31eF83a530Fde1B38EE9A18093A333D8Bbbc40D5
