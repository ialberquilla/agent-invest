{
  "name": "@agent-invest/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm typecheck && tsup",
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "ingest:gmx": "tsx src/ingestion/gmx-history.ts",
    "ingest:coingecko-market-caps": "tsx src/ingestion/coingecko-market-caps.ts",
    "smoke:gmx:dry-run": "node scripts/smoke-gmx-dry-run.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@opencode-ai/sdk": "^1.14.25",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.2",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.3.0",
    "tsx": "^4.20.6"
  }
}
